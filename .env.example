# Optional. Without a key, the local server starts with AI disabled.
OPENAI_API_KEY=
# Required with a key: choose a Responses API model supporting JSON mode.
LLM_MODEL=
API_PORT=3001
LLM_MAX_PROMPT_LENGTH=4000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=30000
LLM_REPAIR_ATTEMPTS=1
LLM_RATE_LIMIT=6
LLM_RATE_WINDOW_MS=60000
LLM_MAX_OUTPUT_BYTES=100000
LLM_REPAIR_BYTES=12000
# Opt in only after checking the selected model supports temperature.
LLM_SUPPORTS_TEMPERATURE=false
# Optional live-eval pricing, USD per million tokens. Never assumed from model names.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Secrets must never use a VITE_ prefix.
