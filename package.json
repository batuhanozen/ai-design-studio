{
  "name": "ai-design-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=8.15"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --strictPort",
    "eval:offline": "node --import tsx evals/offline.ts",
    "eval:live": "node --env-file-if-exists=.env --import tsx evals/live.ts"
  },
  "dependencies": {
    "openai": "7.39.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "9.3.4",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "22.1.0",
    "prettier": "3.2.5",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
